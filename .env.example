# Copy to .env (npm run dev does this for you and fills in the generated values).
# No real secrets belong in this file.

# --- auth ---
AUTH_MODE=dev                      # dev | cognito
PUBLIC_BASE_URL=http://localhost:8787
AUTH_ISSUER_URL=http://localhost:8788
DASHBOARD_URL=http://localhost:5173
SIMULATOR_URL=http://localhost:5174
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# --- data ---
DDB_ENDPOINT=http://localhost:8000
TABLE_NAME=CareCircle
CRYPTO_MODE=local                  # local | kms
LOCAL_DATA_KEY=<32-byte base64, generated by npm run gen:key>
KMS_KEY_ID=

# --- alerts ---
QUEUE_MODE=memory                  # memory | sqs
QUEUE_URL=
MAIL_MODE=smtp                     # smtp | ses | memory
SMTP_URL=smtp://localhost:1025
MAIL_FROM=care-circle@example.com
RUN_WORKERS=true                   # run materializer + sweep + notifier inside the API process (local mode)
WORKER_INTERVAL_SEC=60

# --- demo controls (dev only) ---
DEV_ENDPOINTS=true
DEV_KEY=<random, generated>
SEED_ON_START=demo                 # demo | fresh | (empty) — seed when the local table is created

# --- simulator ---
SIM_AGENT=scripted                 # scripted | bedrock
BEDROCK_MODEL_ID=                  # set by the human; Bedrock use needs approval
MCP_URL=http://localhost:8787/mcp
SIM_AGENT_PORT=8790

# --- AWS ---
AWS_REGION=us-east-1
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_IDS=
COGNITO_DOMAIN=
OAUTH_PROXY=false
